{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/rezahh107/PR-Inspector/schemas/aigov/v2.5.0/review_execution.schema.json","title":"AIGOV Inactive Review Execution Contract","description":"Inactive, non-authoritative AIGOV v2.5.0 contract carrier.","type":"object","additionalProperties":false,"properties":{"contract_type":{"const":"review_execution"},"contract_version":{"const":"1.0"},"execution_id":{"$ref":"common.schema.json#/$defs/record_id"},"target":{"$ref":"common.schema.json#/$defs/pr_target_identity"},"protocol":{"$ref":"common.schema.json#/$defs/protocol_identity"},"inspector":{"$ref":"common.schema.json#/$defs/inspector_identity"},"inspection_profile":{"$ref":"common.schema.json#/$defs/inspection_profile"},"evidence_profile":{"$ref":"common.schema.json#/$defs/evidence_profile"},"policy_resolution_reference":{"$ref":"common.schema.json#/$defs/record_reference"},"tool_execution_attestations":{"type":"array","items":{"$ref":"common.schema.json#/$defs/record_reference"},"uniqueItems":true},"required_execution_evidence":{"type":"array","items":{"$ref":"common.schema.json#/$defs/evidence_reference"},"uniqueItems":true},"execution_result":{"enum":["not_started","running","completed","failed","blocked"]},"completion_status":{"enum":["not_complete","evidence_complete","pending_trusted_completion"]}},"required":["contract_type","contract_version","execution_id","target","protocol","inspector","inspection_profile","evidence_profile","policy_resolution_reference","tool_execution_attestations","required_execution_evidence","execution_result","completion_status"],"allOf":[{"if":{"properties":{"execution_result":{"const":"completed"}},"required":["execution_result"]},"then":{"properties":{"tool_execution_attestations":{"minItems":1},"required_execution_evidence":{"minItems":1},"completion_status":{"enum":["evidence_complete","pending_trusted_completion"]}}}}]}