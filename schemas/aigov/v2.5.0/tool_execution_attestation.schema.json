{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rezahh107/PR-Inspector/schemas/aigov/v2.5.0/tool_execution_attestation.schema.json",
  "title": "AIGOV Inactive Tool Execution Attestation Contract",
  "description": "Inactive carrier aligned with AIGOV-TOOL-EXECUTION-001 source-to-parameter, invocation, result, read-back and claim binding semantics.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_type": {
      "const": "tool_execution_attestation"
    },
    "contract_version": {
      "const": "1.0"
    },
    "activation_state": {
      "const": "inactive"
    },
    "carrier_id": {
      "const": "tool_execution_attestation"
    },
    "governed_rule_id": {
      "const": "AIGOV-TOOL-EXECUTION-001"
    },
    "attestation_id": {
      "$ref": "common.schema.json#/$defs/record_id"
    },
    "capability_authority_ref": {
      "$ref": "common.schema.json#/$defs/authority_reference"
    },
    "selected_tool": {
      "$ref": "common.schema.json#/$defs/record_id"
    },
    "tool_schema_identity": {
      "$ref": "common.schema.json#/$defs/non_empty_string"
    },
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_type": {
          "enum": [
            "repository",
            "pr",
            "branch",
            "head",
            "record",
            "resource"
          ]
        },
        "exact_identity": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        }
      },
      "required": [
        "target_type",
        "exact_identity"
      ]
    },
    "provider_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        },
        "provider_identity": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        }
      },
      "required": [
        "provider",
        "provider_identity"
      ]
    },
    "workflow_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_name": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        },
        "workflow_file": {
          "type": "string",
          "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$"
        },
        "trusted_revision_sha": {
          "$ref": "common.schema.json#/$defs/git_commit_sha"
        }
      },
      "required": [
        "workflow_name",
        "workflow_file",
        "trusted_revision_sha"
      ]
    },
    "run_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "$ref": "common.schema.json#/$defs/positive_integer"
        },
        "run_attempt": {
          "$ref": "common.schema.json#/$defs/positive_integer"
        }
      },
      "required": [
        "run_id",
        "run_attempt"
      ]
    },
    "job_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "$ref": "common.schema.json#/$defs/positive_integer"
        },
        "job_name": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        }
      },
      "required": [
        "job_id",
        "job_name"
      ]
    },
    "step_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_number": {
          "$ref": "common.schema.json#/$defs/positive_integer"
        },
        "step_name": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        }
      },
      "required": [
        "step_number",
        "step_name"
      ]
    },
    "command_or_validator_identity": {
      "$ref": "common.schema.json#/$defs/non_empty_string"
    },
    "parameter_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "parameter_name": {
            "$ref": "common.schema.json#/$defs/non_empty_string"
          },
          "supplied_value_or_canonical_digest": {
            "$ref": "common.schema.json#/$defs/non_empty_string"
          },
          "source_ref": {
            "$ref": "common.schema.json#/$defs/authority_reference"
          },
          "source_field_path": {
            "$ref": "common.schema.json#/$defs/non_empty_string"
          },
          "source_identity": {
            "$ref": "common.schema.json#/$defs/non_empty_string"
          },
          "parameter_constraint_authority_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/record_reference"
            },
            "uniqueItems": true
          },
          "transformation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "transformation_id": {
                "$ref": "common.schema.json#/$defs/record_id"
              },
              "validation_ref": {
                "$ref": "common.schema.json#/$defs/nullable_evidence_reference"
              }
            },
            "required": [
              "transformation_id",
              "validation_ref"
            ]
          },
          "binding_status": {
            "$ref": "common.schema.json#/$defs/tool_parameter_binding_status"
          }
        },
        "required": [
          "parameter_name",
          "supplied_value_or_canonical_digest",
          "source_ref",
          "source_field_path",
          "source_identity",
          "parameter_constraint_authority_refs",
          "transformation",
          "binding_status"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "invocation_record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invocation_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/record_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "claimed_execution": {
          "type": "boolean"
        },
        "execution_status": {
          "$ref": "common.schema.json#/$defs/tool_execution_status"
        },
        "executed_at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "invocation_id",
        "claimed_execution",
        "execution_status",
        "executed_at"
      ]
    },
    "execution_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "captured_result_fields": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/non_empty_string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "result_identity",
        "captured_result_fields"
      ]
    },
    "state_changed": {
      "type": "boolean"
    },
    "readback_status": {
      "$ref": "common.schema.json#/$defs/tool_readback_status"
    },
    "readback_ref": {
      "$ref": "common.schema.json#/$defs/nullable_evidence_reference"
    },
    "readback_not_required_authority_ref": {
      "$ref": "common.schema.json#/$defs/nullable_evidence_reference"
    },
    "final_claim_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "$ref": "common.schema.json#/$defs/record_id"
          },
          "result_field_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/non_empty_string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "binding_status": {
            "$ref": "common.schema.json#/$defs/tool_claim_binding_status"
          }
        },
        "required": [
          "claim_id",
          "result_field_refs",
          "binding_status"
        ]
      },
      "uniqueItems": true
    },
    "evidence_retrieval_method": {
      "enum": [
        "github_api",
        "artifact_download",
        "log_api",
        "local_verified_execution"
      ]
    },
    "pagination_completeness_ref": {
      "$ref": "common.schema.json#/$defs/nullable_evidence_reference"
    },
    "authentication_provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authentication_method": {
          "enum": [
            "github_oidc",
            "github_app_installation",
            "github_api_authenticated",
            "local_process_attested"
          ]
        },
        "authenticated_subject": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        },
        "provenance_evidence_ref": {
          "$ref": "common.schema.json#/$defs/evidence_reference"
        }
      },
      "required": [
        "authentication_method",
        "authenticated_subject",
        "provenance_evidence_ref"
      ]
    }
  },
  "required": [
    "contract_type",
    "contract_version",
    "activation_state",
    "carrier_id",
    "governed_rule_id",
    "attestation_id",
    "capability_authority_ref",
    "selected_tool",
    "tool_schema_identity",
    "target_identity",
    "provider_identity",
    "workflow_identity",
    "run_identity",
    "job_identity",
    "step_identity",
    "command_or_validator_identity",
    "parameter_bindings",
    "invocation_record",
    "execution_result",
    "state_changed",
    "readback_status",
    "readback_ref",
    "readback_not_required_authority_ref",
    "final_claim_bindings",
    "evidence_retrieval_method",
    "pagination_completeness_ref",
    "authentication_provenance"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "invocation_record": {
            "properties": {
              "claimed_execution": {
                "const": true
              }
            },
            "required": [
              "claimed_execution"
            ]
          }
        },
        "required": [
          "invocation_record"
        ]
      },
      "then": {
        "properties": {
          "invocation_record": {
            "properties": {
              "invocation_id": {
                "$ref": "common.schema.json#/$defs/record_id"
              },
              "execution_status": {
                "enum": [
                  "invoked",
                  "success",
                  "failed"
                ]
              },
              "executed_at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state_changed": {
            "const": true
          }
        },
        "required": [
          "state_changed"
        ]
      },
      "then": {
        "properties": {
          "readback_status": {
            "const": "VERIFIED"
          },
          "readback_ref": {
            "$ref": "common.schema.json#/$defs/evidence_reference"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "readback_status": {
            "const": "READBACK_NOT_REQUIRED"
          }
        },
        "required": [
          "readback_status"
        ]
      },
      "then": {
        "properties": {
          "state_changed": {
            "const": false
          },
          "readback_not_required_authority_ref": {
            "$ref": "common.schema.json#/$defs/evidence_reference"
          }
        }
      }
    },
    {
      "properties": {
        "parameter_bindings": {
          "items": {
            "properties": {
              "binding_status": {
                "enum": [
                  "VERIFIED_SOURCE_BOUND",
                  "VERIFIED_TRANSFORMATION_BOUND"
                ]
              }
            }
          }
        },
        "final_claim_bindings": {
          "items": {
            "properties": {
              "binding_status": {
                "enum": [
                  "VERIFIED_RESULT_BOUND",
                  "VERIFIED_READBACK_BOUND"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
