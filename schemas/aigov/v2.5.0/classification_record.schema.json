{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rezahh107/PR-Inspector/schemas/aigov/v2.5.0/classification_record.schema.json",
  "title": "AIGOV Inactive Classification Record Contract",
  "description": "Inactive, non-authoritative AIGOV v2.5.0 contract carrier for future PR-Inspector support.",
  "$defs": {
    "classification_terminal_class": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_type": {
      "const": "classification_record"
    },
    "contract_version": {
      "const": "1.0"
    },
    "activation_state": {
      "const": "inactive"
    },
    "classification_id": {
      "$ref": "common.schema.json#/$defs/record_id"
    },
    "target_identity": {
      "$ref": "common.schema.json#/$defs/target_identity"
    },
    "observed_facts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fact_id": {
            "$ref": "common.schema.json#/$defs/record_id"
          },
          "fact_kind": {
            "enum": [
              "changed_path",
              "boundary_signal",
              "runtime_effect",
              "governance_effect",
              "trust_effect"
            ]
          },
          "fact_value": {
            "$ref": "common.schema.json#/$defs/non_empty_string"
          },
          "evidence_ref": {
            "$ref": "common.schema.json#/$defs/evidence_reference"
          }
        },
        "required": [
          "fact_id",
          "fact_kind",
          "fact_value",
          "evidence_ref"
        ]
      }
    },
    "classification_resolution_status": {
      "$ref": "common.schema.json#/$defs/classification_resolution_status"
    },
    "final_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/classification_terminal_class"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification_outcome": {
      "$ref": "common.schema.json#/$defs/classification_outcome"
    },
    "boundary_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AIGOV-BOUNDARY-[A-Z0-9-]+$"
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidence_reference"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "classification_authority_ref": {
      "$ref": "common.schema.json#/$defs/authority_reference"
    },
    "evidence_sufficiency": {
      "enum": [
        "sufficient",
        "insufficient"
      ]
    },
    "recovery_condition": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "required": [
    "contract_type",
    "contract_version",
    "activation_state",
    "classification_id",
    "target_identity",
    "observed_facts",
    "classification_resolution_status",
    "final_class",
    "classification_outcome",
    "boundary_ids",
    "evidence_refs",
    "classification_authority_ref",
    "evidence_sufficiency",
    "recovery_condition"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "classification_resolution_status": {
            "const": "resolved"
          }
        },
        "required": [
          "classification_resolution_status"
        ]
      },
      "then": {
        "properties": {
          "final_class": {
            "$ref": "#/$defs/classification_terminal_class"
          },
          "evidence_sufficiency": {
            "const": "sufficient"
          }
        }
      },
      "else": {
        "properties": {
          "final_class": {
            "type": "null"
          },
          "classification_outcome": {
            "const": "blocked_insufficient_evidence"
          },
          "evidence_sufficiency": {
            "const": "insufficient"
          },
          "recovery_condition": {
            "type": "string"
          }
        }
      }
    }
  ]
}
