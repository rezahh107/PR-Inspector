{
  "$defs": {
    "actionKind": {
      "enum": [
        "merge_now",
        "owner_confirmation",
        "human_technical_review",
        "specialist_review",
        "repair",
        "verify",
        "repair_and_verify",
        "rerun_review",
        "blocked_internal_error"
      ]
    },
    "promptKind": {
      "enum": [
        null,
        "implementer_repair_prompt",
        "verification_prompt",
        "fresh_review_prompt",
        "human_review_handoff",
        "specialist_review_handoff"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "reasonCode": {
      "pattern": "^RSN-[A-Z0-9-]+$",
      "type": "string"
    },
    "reasonCodeList": {
      "items": {
        "$ref": "#/$defs/reasonCode"
      },
      "type": "array",
      "uniqueItems": true
    },
    "recipient": {
      "enum": [
        "none",
        "project_owner",
        "implementer_model",
        "reviewer_model",
        "human_technical_reviewer",
        "security_or_domain_specialist"
      ]
    },
    "securityProfileProjection": {
      "additionalProperties": false,
      "properties": {
        "blocks_green_merge_recommendation": {
          "type": "boolean"
        },
        "controls": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "classification": {
                "enum": [
                  "optional_hardening",
                  "required"
                ]
              },
              "control": {
                "type": "string"
              }
            },
            "required": [
              "control",
              "classification"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "github_app_exact_source_enforcement": {
          "enum": [
            "optional_hardening",
            "required"
          ]
        },
        "governance_evidence_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "governance_evidence_status": {
          "enum": [
            "not_provided",
            "rejected",
            "verified"
          ]
        },
        "merge_authorized": {
          "enum": [
            "not_claimed",
            "rejected",
            "verified"
          ]
        },
        "name": {
          "const": "personal_ai_operated_strong_governance_minimum_security"
        },
        "reason_codes": {
          "$ref": "#/$defs/reasonCodeList"
        },
        "repository_hosted_enforcement": {
          "enum": [
            "not_verified",
            "verified"
          ]
        },
        "repository_hosted_requirement": {
          "enum": [
            "optional_hardening",
            "required"
          ]
        },
        "repository_settings_enforced": {
          "enum": [
            "not_claimed",
            "rejected",
            "verified"
          ]
        },
        "security_level": {
          "const": "minimum_security"
        },
        "sequence_ci_enforced": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "security_level",
        "sequence_ci_enforced",
        "repository_hosted_requirement",
        "repository_hosted_enforcement",
        "github_app_exact_source_enforcement",
        "repository_settings_enforced",
        "merge_authorized",
        "governance_evidence_status",
        "governance_evidence_id",
        "blocks_green_merge_recommendation",
        "reason_codes",
        "controls"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/rezahh107/PR-Inspector/protocols/v1.11.0/schemas/decision-projection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_requirement": {
      "enum": [
        "NO_ADDITIONAL_TECHNICAL_APPROVAL",
        "PROJECT_OWNER_CONFIRMATION",
        "HUMAN_TECHNICAL_REVIEW_REQUIRED",
        "SECURITY_OR_DOMAIN_SPECIALIST_REQUIRED"
      ]
    },
    "next_action": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/actionKind"
        },
        "may_modify_code": {
          "type": "boolean"
        },
        "prompt_kind": {
          "$ref": "#/$defs/promptKind"
        },
        "prompt_required": {
          "type": "boolean"
        },
        "reason_codes": {
          "$ref": "#/$defs/reasonCodeList"
        },
        "recipient": {
          "$ref": "#/$defs/recipient"
        }
      },
      "required": [
        "kind",
        "recipient",
        "may_modify_code",
        "prompt_required",
        "prompt_kind",
        "reason_codes"
      ],
      "type": "object"
    },
    "owner_readiness": {
      "additionalProperties": false,
      "properties": {
        "action_kind": {
          "$ref": "#/$defs/actionKind"
        },
        "color": {
          "enum": [
            "GREEN",
            "YELLOW",
            "RED",
            "BLOCKED"
          ]
        },
        "message_key": {
          "pattern": "^[a-z_]+$",
          "type": "string"
        },
        "reason_codes": {
          "$ref": "#/$defs/reasonCodeList"
        }
      },
      "required": [
        "color",
        "action_kind",
        "message_key",
        "reason_codes"
      ],
      "type": "object"
    },
    "protocol_version": {
      "const": "v1.11.0"
    },
    "reason_details": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "reason_code": {
            "$ref": "#/$defs/reasonCode"
          },
          "subjects": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "reason_code",
          "subjects"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "required_actions": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "review_identity": {
      "additionalProperties": false,
      "properties": {
        "reviewed_head_sha": {
          "pattern": "^(UNKNOWN|[0-9a-f]{40})$",
          "type": "string"
        },
        "validity": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "validity",
        "reviewed_head_sha"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "security_profile": {
      "$ref": "#/$defs/securityProfileProjection"
    },
    "technical_status": {
      "enum": [
        "GREEN_TECHNICALLY_READY",
        "YELLOW_CHANGES_OR_VERIFICATION_REQUIRED",
        "RED_DO_NOT_MERGE"
      ]
    },
    "technical_status_reason_codes": {
      "$ref": "#/$defs/reasonCodeList"
    },
    "inspection_profile": {
      "type": "string",
      "enum": [
        "minimal",
        "strict"
      ],
      "default": "minimal"
    },
    "technical_decision": {
      "type": "object",
      "required": [
        "status",
        "reason_codes"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "GREEN",
            "YELLOW",
            "RED"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "blocking_medium_finding",
              "bot_collection_incomplete",
              "critical_supported_finding",
              "high_reproduced_finding",
              "incomplete_technical_scope",
              "required_technical_check_failed",
              "stale_technical_review_identity",
              "unresolved_valid_bot_finding"
            ]
          }
        }
      }
    },
    "governance_decision": {
      "type": "object",
      "required": [
        "status",
        "reason_codes"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_REQUESTED",
            "VERIFIED",
            "GAP_FOUND",
            "NOT_VERIFIABLE"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "branch_protection_unavailable",
              "bypass_actors_unknown",
              "merge_authorization_unverified",
              "merge_queue_unavailable",
              "repository_settings_not_verified",
              "required_checks_not_verified",
              "required_review_enforcement_absent",
              "rulesets_unavailable",
              "sequence_enforcement_missing"
            ]
          }
        }
      }
    },
    "overall_recommendation": {
      "type": "object",
      "required": [
        "technical_ready",
        "merge_governance_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "technical_ready": {
          "type": "boolean"
        },
        "merge_governance_verified": {
          "type": "boolean"
        }
      }
    },
    "governance_follow_up": {
      "type": "object",
      "required": [
        "kind",
        "may_modify_code",
        "prompt_required"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "informational_gap",
            "access_limitation"
          ]
        },
        "may_modify_code": {
          "const": false
        },
        "prompt_required": {
          "const": false
        }
      }
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "inspection_profile",
    "technical_decision",
    "governance_decision",
    "overall_recommendation",
    "governance_follow_up"
  ],
  "title": "PR Inspector Canonical Decision Projection v1.11.0",
  "type": "object"
}
