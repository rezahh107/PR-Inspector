{
  "$id": "https://github.com/rezahh107/PR-Inspector/protocols/v1.12.0/schemas/review-package.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "capabilities": {
      "type": "object"
    },
    "change_summary": {
      "type": "object"
    },
    "checks": {
      "type": "array"
    },
    "decision": {
      "type": "object"
    },
    "evidence_records": {
      "type": "array"
    },
    "external_review_intake": {
      "additionalProperties": false,
      "properties": {
        "sources_inspected": {
          "items": {
            "properties": {
              "inspected": {
                "type": "boolean"
              },
              "reviewed_head_sha": {
                "type": "string"
              },
              "source_id": {
                "type": "string"
              },
              "source_type": {
                "type": "string"
              }
            },
            "required": [
              "source_id",
              "source_type",
              "inspected",
              "reviewed_head_sha"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "suggestions": {
          "items": {
            "properties": {
              "external_suggestion_id": {
                "type": "string"
              },
              "linked_finding_ids": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "source_id": {
                "type": "string"
              },
              "triage_decision": {
                "enum": [
                  "accepted",
                  "resolved",
                  "duplicate",
                  "false_positive",
                  "deferred",
                  "insufficient_evidence",
                  "out_of_scope",
                  "stale",
                  "rejected"
                ]
              }
            },
            "required": [
              "external_suggestion_id",
              "source_id",
              "triage_decision",
              "linked_finding_ids"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "sources_inspected",
        "suggestions"
      ],
      "type": "object"
    },
    "external_review_reconciliation": {
      "additionalProperties": false,
      "properties": {
        "collection_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ]
        },
        "counts": {
          "additionalProperties": false,
          "properties": {
            "accepted": {
              "minimum": 0,
              "type": "integer"
            },
            "deferred": {
              "minimum": 0,
              "type": "integer"
            },
            "duplicate": {
              "minimum": 0,
              "type": "integer"
            },
            "false_positive": {
              "minimum": 0,
              "type": "integer"
            },
            "insufficient_evidence": {
              "minimum": 0,
              "type": "integer"
            },
            "out_of_scope": {
              "minimum": 0,
              "type": "integer"
            },
            "resolved": {
              "minimum": 0,
              "type": "integer"
            },
            "stale": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "accepted",
            "resolved",
            "duplicate",
            "false_positive",
            "deferred",
            "insufficient_evidence",
            "out_of_scope",
            "stale"
          ],
          "type": "object"
        },
        "inspected_total": {
          "minimum": 0,
          "type": "integer"
        },
        "open_bot_sources_total": {
          "minimum": 0,
          "type": "integer"
        },
        "suggestion_results": {
          "type": "array"
        },
        "uninspected_source_ids": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "valid_blocking_finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "collection_status",
        "counts",
        "inspected_total",
        "open_bot_sources_total",
        "suggestion_results",
        "uninspected_source_ids",
        "valid_blocking_finding_ids"
      ],
      "type": "object"
    },
    "findings": {
      "type": "array"
    },
    "governance_decision": {
      "properties": {
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "NOT_REQUESTED",
            "VERIFIED",
            "GAP_FOUND",
            "NOT_VERIFIABLE"
          ]
        }
      },
      "required": [
        "status",
        "reason_codes"
      ],
      "type": "object"
    },
    "inspection_profile": {
      "default": "minimal",
      "enum": [
        "minimal",
        "strict"
      ]
    },
    "out_of_scope_observations": {
      "type": "array"
    },
    "overall_recommendation": {
      "properties": {
        "merge_governance_verified": {
          "type": "boolean"
        },
        "technical_ready": {
          "type": "boolean"
        }
      },
      "required": [
        "technical_ready",
        "merge_governance_verified"
      ],
      "type": "object"
    },
    "owner_card": {
      "type": "object"
    },
    "protocol_version": {
      "enum": [
        "v1.11.0",
        "v1.11.1",
        "v1.12.0"
      ]
    },
    "red_gate_flags": {
      "type": "array"
    },
    "required_actions": {
      "type": "array"
    },
    "review_identity": {
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "scope": {
      "type": "object"
    },
    "security_profile": {
      "type": "object"
    },
    "technical_decision": {
      "properties": {
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "GREEN",
            "YELLOW",
            "RED"
          ]
        }
      },
      "required": [
        "status",
        "reason_codes"
      ],
      "type": "object"
    },
    "unverified_areas": {
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "review_identity",
    "decision",
    "capabilities",
    "scope",
    "change_summary",
    "evidence_records",
    "checks",
    "findings",
    "unverified_areas",
    "required_actions",
    "out_of_scope_observations",
    "owner_card",
    "red_gate_flags",
    "security_profile",
    "inspection_profile",
    "technical_decision",
    "governance_decision",
    "overall_recommendation",
    "external_review_intake",
    "external_review_reconciliation"
  ],
  "title": "PR Inspector Verified Review Package v1.12.0",
  "type": "object"
}
